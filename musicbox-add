#!/usr/bin/env python3
"""
musicbox-add: Extract albums from the current Safari tab and add them to MusicBox.

Usage:
    Open an article (e.g. RA best-of list) in Safari, then run:
        ./musicbox-add

    Or pass a URL to fetch directly (works for non-JS sites):
        ./musicbox-add https://example.com/best-albums

    Options:
        --tag TAG       Auto-tag all added items (e.g. --tag "yearly-list")
        --dry-run       Show what would be added without actually adding

    Environment:
        ANTHROPIC_API_KEY  — optional override; default is read from ~/.config/musicbox/api_key
        MUSICBOX_MODEL     — optional, default: claude-haiku-4-5-20251001
"""

import json, os, subprocess, sys, time, urllib.request, urllib.parse, urllib.error, argparse, re, unicodedata

from musicbox_core import search_with_fallbacks, add_many_to_musicbox

def load_api_key():
    """Read the Anthropic API key from the environment or ~/.config/musicbox/api_key."""
    key = os.environ.get("ANTHROPIC_API_KEY", "")
    if not key:
        key_file = os.path.expanduser("~/.config/musicbox/api_key")
        if os.path.exists(key_file):
            with open(key_file) as f:
                key = f.read().strip()
    if not key:
        sys.exit("Set ANTHROPIC_API_KEY or put a key in ~/.config/musicbox/api_key. Get one at https://console.anthropic.com/")
    return key

MODEL = os.environ.get("MUSICBOX_MODEL", "claude-haiku-4-5-20251001")
CLAUDE_URL = "https://api.anthropic.com/v1/messages"

def get_safari_text():
    """Get the rendered innerText from the current Safari tab via AppleScript."""
    script = 'tell application "Safari" to do JavaScript "document.body.innerText.substring(0, 60000)" in current tab of front window'
    result = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=15)
    if result.returncode != 0:
        sys.exit(f"Failed to get Safari text: {result.stderr.strip()}")
    return result.stdout.strip()

def fetch_url_text(url):
    """Fetch a URL and return its text content (for non-JS sites)."""
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return resp.read().decode("utf-8", errors="replace")[:60000]

def extract_albums(text, api_key):
    """Ask Claude to extract artist-album pairs from the text."""
    prompt = (
        "You are reading a music article that lists albums, EPs, or compilations. "
        "Extract EVERY album/EP/compilation mentioned. Be thorough — scan the ENTIRE text.\n\n"
        "Rules:\n"
        "- Return one entry per line in the format: Artist - Album Title\n"
        "- Only include items that are explicitly named in the article\n"
        "- Do NOT invent, infer, or hallucinate entries that aren't in the text\n"
        "- Do NOT include individual song/track names — only album/EP/compilation titles\n"
        "- For compilations, use the label or 'Various Artists' as the artist\n"
        "- No numbering, bullet points, or commentary\n\n"
        "Article text:\n\n"
        + text
    )
    body = json.dumps({
        "model": MODEL,
        "max_tokens": 4096,
        "messages": [{"role": "user", "content": prompt}],
    }).encode()
    req = urllib.request.Request(CLAUDE_URL, data=body, headers={
        "x-api-key": api_key,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
    })
    with urllib.request.urlopen(req, timeout=60) as resp:
        result = json.load(resp)
    lines = [line.strip() for line in result["content"][0]["text"].splitlines() if line.strip()]
    # Filter out anything that doesn't look like "Artist - Title"
    return [l for l in lines if " - " in l]

def notify(title, message):
    """Show a macOS notification."""
    subprocess.run(["osascript", "-e",
        f'display notification "{message}" with title "{title}"'],
        capture_output=True, timeout=5)

def main():
    parser = argparse.ArgumentParser(description="Extract albums from an article and add to MusicBox")
    parser.add_argument("url", nargs="?", help="URL to fetch (omit to read current Safari tab)")
    parser.add_argument("--tag", help="Auto-tag all added items (e.g. 'yearly-list')")
    parser.add_argument("--dry-run", action="store_true", help="Show what would be added without adding")
    args = parser.parse_args()
    api_key = load_api_key()

    # Step 1: Get article text
    if args.url:
        print(f"Fetching {args.url}...")
        text = fetch_url_text(args.url)
    else:
        print("Reading current Safari tab...")
        text = get_safari_text()

    if not text or len(text) < 50:
        sys.exit("No meaningful text found.")

    print(f"Got {len(text):,} chars of text.")

    # Step 2: Extract albums via Claude
    print(f"Asking Claude ({MODEL}) to extract albums...")
    albums = extract_albums(text, api_key)
    print(f"\nFound {len(albums)} albums:")
    for i, a in enumerate(albums, 1):
        print(f"  {i:2}. {a}")
    print()

    if args.dry_run:
        print("Dry run — searching iTunes but not adding to MusicBox.\n")

    # Step 3: Search iTunes for each album
    found_urls = []
    skipped = []
    for entry in albums:
        parts = entry.split(" - ", 1)
        artist = parts[0].strip() if len(parts) == 2 else ""
        title = parts[1].strip() if len(parts) == 2 else entry

        # Search with verification and fallbacks
        apple_url, match_info = search_with_fallbacks(artist, title)

        if apple_url:
            print(f"  + {entry}")
            print(f"    -> {match_info}")
            found_urls.append(apple_url)
        else:
            print(f"  x {entry} (not found on Apple Music)")
            skipped.append(entry)

    # Step 4: Add all to MusicBox in one batch dialog
    if found_urls and not args.dry_run:
        print(f"\nOpening {len(found_urls)} albums in MusicBox (single dialog)...")
        add_many_to_musicbox(found_urls)

    # Summary
    verb = "Would add" if args.dry_run else "Sent"
    summary = f"{verb} {len(found_urls)}/{len(albums)} to MusicBox."
    print(f"\nDone! {summary}")
    if skipped:
        print(f"Skipped {len(skipped)}:")
        for s in skipped:
            print(f"  - {s}")

    # macOS notification (useful when run from Share Sheet with no terminal)
    if not args.dry_run and found_urls:
        skip_note = f" ({len(skipped)} not found)" if skipped else ""
        notify("MusicBox Add", f"Added {len(found_urls)} albums{skip_note}")

if __name__ == "__main__":
    main()
